#!/usr/bin/env python3
"""
runWildfireAV — single entry point for the ELMFIRE / FARSITE validation pipeline.

Usage
-----
  runWildfireAV --start setup            # full reset: delete cases, setup, run, pdf
  runWildfireAV --start run              # clean sim outputs, run all cases, pdf
  runWildfireAV --start run --resume     # keep outputs, skip finished cases (after a timeout)
  runWildfireAV --start pdf              # regenerate the validation pdf only
  runWildfireAV --start run --dry-run    # show what would run and each case's last status

Options for the run phase
-------------------------
  --workers N        cases at once (default MAX_PARALLEL_CASES)
  --cases ID ...     only these cases (e.g. 00001 3)
  --resume           (= --skip-done) skip cases with ELMFIRE output; nothing is cleaned
  --heartbeat MIN    minutes between progress heartbeats (default BATCH_HEARTBEAT_MIN)
  --no-preflight     skip the environment checks

Monitoring
----------
The job log shows START / OK / FAIL per case plus periodic heartbeats; every
case has <case>/pipeline.log and <case>/status.json, and
``python tools/monitorBatch.py`` gives a live table.

SLURM example
-------------
  #SBATCH --job-name=wildfire_av
  #SBATCH --ntasks=1
  #SBATCH --cpus-per-task=16
  #SBATCH --time=24:00:00
  #SBATCH --signal=TERM@300          # 5 min warning so running cases record 'interrupted'
  conda activate autoValidate
  export LFPS_EMAIL=you@example.com
  python -u /path/to/runWildfireAV --start run --resume --workers 14
"""

from __future__ import annotations

import argparse
import os
import socket
import subprocess
import sys
import time
import traceback
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path[:0] = [str(ROOT), str(ROOT / "pipeline"), str(ROOT / "setup")]

import pipelineConfig as cfg
from common import fmt_duration

FIRE_ROOT = Path(cfg.FIRE_ROOT)
PHASES = ["setup", "run", "pdf"]


# ---------------------------------------------------------------------------
# Clean helpers
# ---------------------------------------------------------------------------

def _clean_outputs(folders: list[Path]) -> None:
    """Delete per-case simulation outputs (keeps LANDFIRE.tif and metadata)."""
    import cleanPipelineOutputs as cleaner
    steps = cleaner._STEPS[cleaner.STEP_NAMES.index("landfire_bands"):]
    total = 0
    for folder in folders:
        targets = cleaner._targets_for_case(folder, steps, include_wind_tifs=True) + [folder / "farsite"]
        total += sum(cleaner._delete(t, dry_run=False, verbose=False) for t in targets)
    print(f"  Cleaned simulation outputs of {len(folders)} case(s) ({total} item(s) removed; "
          "LANDFIRE.tif kept).  Use --resume to keep outputs.")


# ---------------------------------------------------------------------------
# Phases
# ---------------------------------------------------------------------------

def phase_setup() -> int:
    """Full reset (delete case folders and summaries), then setup."""
    import setupPipeline as sp
    print(f"  Setup log → {sp.run(clean=True)}")
    return 0


def phase_run(args, clean: bool) -> int:
    import runBatch
    folders = runBatch.discover(FIRE_ROOT, args.cases, args.skip_done)
    if args.dry_run:
        runBatch.print_dry_run(folders)
        return 0
    if not folders:
        print("  No cases to process.")
        return 0
    if clean:
        _clean_outputs(folders)
    return runBatch.run_batch(folders, args.workers, args.heartbeat)


def preflight_first(args) -> bool:
    """Check the environment before any phase starts, so a missing tool fails in
    seconds instead of after setup.  Before setup there are no cases yet, so every
    download is assumed needed and the raw setup inputs are checked as well."""
    import preflight
    import runBatch
    if args.start == "setup":
        return preflight.run(None, args.workers, fresh=True)
    folders = runBatch.discover(FIRE_ROOT, args.cases, args.skip_done)
    return not folders or preflight.run(folders, args.workers, fresh=not args.skip_done)


def phase_pdf() -> int:
    import validation.getValidationPDF as pdf
    pdf.main()
    return 0


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _git_rev() -> str:
    try:
        return subprocess.run(["git", "-C", str(ROOT), "log", "-1", "--format=%h %cd", "--date=short"],
                              capture_output=True, text=True, timeout=5).stdout.strip() or "?"
    except Exception:
        return "?"


def main() -> int:
    import runBatch
    p = argparse.ArgumentParser(description="ELMFIRE / FARSITE validation pipeline entry point.",
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    p.add_argument("--start", choices=PHASES, required=True, help="phase to start from; later phases also run")
    runBatch.add_run_args(p)
    args = p.parse_args()
    active = PHASES[PHASES.index(args.start):]

    slurm = os.environ.get("SLURM_JOB_ID")
    print("=" * 72)
    print("WILDFIRE VALIDATION PIPELINE")
    print(f"  phases      : {' → '.join(active)}")
    print(f"  fire root   : {FIRE_ROOT}")
    print(f"  wind        : {runBatch.describe_wind()}")
    print(f"  host        : {socket.gethostname()}" + (f"   SLURM job {slurm}" if slurm else ""))
    print(f"  code        : {ROOT}  ({_git_rev()})")
    print(f"  python      : {sys.executable}")
    print("=" * 72, flush=True)

    t_total, rc = time.monotonic(), 0
    if "run" in active and not (args.dry_run or args.no_preflight):
        if not preflight_first(args):
            print(f"\n{'=' * 72}\nDONE (preflight failed, exit 2)\n{'=' * 72}")
            return 2
    for phase in active:
        t0 = time.monotonic()
        print(f"\n{'─' * 72}\nPHASE: {phase.upper()}\n{'─' * 72}", flush=True)
        if args.dry_run and phase != "run":
            print(f"  (dry run: {phase} skipped)")
            continue
        try:
            if phase == "setup":
                phase_rc = phase_setup()
            elif phase == "run":
                phase_rc = phase_run(args, clean=(args.start == "run" and not args.skip_done))
            else:
                phase_rc = phase_pdf()
        except Exception:
            traceback.print_exc()
            phase_rc = 1
            print(f"\n  PHASE '{phase}' FAILED (see traceback above).", flush=True)
            if phase == "setup":          # nothing sensible to run without setup output
                rc = 1
                break
        rc = rc or phase_rc
        print(f"\n  Phase '{phase}' finished in {fmt_duration(time.monotonic() - t0)} (exit {phase_rc}).",
              flush=True)
        if phase == "run" and phase_rc == 143:   # interrupted: stop here
            break

    print(f"\n{'=' * 72}\nDONE ({fmt_duration(time.monotonic() - t_total)} total, exit {rc})\n{'=' * 72}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
